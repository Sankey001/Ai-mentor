# Required: Primary AI Provider
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Optional: LLM Timeout (in seconds, default: 60)
LLM_TIMEOUT_SECONDS=60

# Optional: Fallback AI Provider
# If omitted, Gemini remains the only AI provider.
GROQ_API_KEY=your_groq_api_key

# Optional: Cloudinary Storage
# If omitted or incomplete, videos remain in local storage.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional: local model environments started by start_app.py.
# Leave any of them empty to run without that feature; see "Workers" in ai_service/README.md.
# Voice worker (Chatterbox): mentors speak in their own recorded voice
VOICE_WORKER_PYTHON=
# Face worker (MuseTalk): the mentor's mouth follows the speech
FACE_WORKER_PYTHON=
MUSETALK_DIR=
# Image step (LivePortrait): mentor images become moving clips
PORTRAIT_PYTHON=
LIVEPORTRAIT_DIR=

# D-ID AI Avatar
DID_API_KEY=your_did_api_key
DID_API_URL=https://api.d-id.com
DID_SOURCE_URL=your_public_avatar_image_url
