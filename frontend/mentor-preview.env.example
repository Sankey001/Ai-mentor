# Settings for the local live-mentor preview (/mentor) without signing in.
# Copy to frontend/.env:  copy frontend\mentor-preview.env.example frontend\.env
# The Firebase values are placeholders the preview does not use; the full platform
# needs real ones (see .env.example).
VITE_MENTOR_PREVIEW=true
VITE_AI_SERVICE_URL=http://127.0.0.1:8000
VITE_API_BASE_URL=http://localhost:5000
VITE_FIREBASE_API_KEY=local-preview-key
VITE_FIREBASE_AUTH_DOMAIN=local-preview.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=local-preview
VITE_FIREBASE_STORAGE_BUCKET=local-preview.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
